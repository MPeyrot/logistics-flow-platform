# Rendu au démarrage : SHIPMENT_SERVICE_URL et INGESTION_SERVICE_URL (origine seule, sans chemin
# ni barre finale, par exemple https://shipment-service-xxxx.a.run.app).
# Les URL passent par des variables : nginx les résout à l'usage (via `resolver`), pas une seule fois
# au démarrage, et démarre même si un service est absent (502 sur ses routes, c'est tout).
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;

    client_max_body_size 12m;
    include /etc/nginx/snippets/security-headers.conf;

    set $shipment_upstream "${SHIPMENT_SERVICE_URL}";
    set $ingestion_upstream "${INGESTION_SERVICE_URL}";

    # Vers Cloud Run : sans le Host de l'amont, Google répond 404 ; SNI pour le TLS.
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_ssl_server_name on;
    proxy_read_timeout 180s;

    location ~ ^/api/scans(/|$) {
        include /etc/nginx/snippets/security-headers.conf;
        proxy_pass $ingestion_upstream;
    }

    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        proxy_pass $shipment_upstream;
    }

    location /.well-known/ {
        include /etc/nginx/snippets/security-headers.conf;
        proxy_pass $shipment_upstream;
    }

    # Fichiers hachés par Angular (outputHashing=all) : le nom suit le contenu, cache sans limite.
    location ~* "-[A-Z0-9]{8}\.(js|css|woff2?|ttf|png|svg|ico|webp)$" {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # Routes Angular : repli sur index.html.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
